{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "skyraptor/laravel-documents",
    "description": "A document system for your Laravel application.",
    "keywords": [
        "laravel",
        "skyraptor",
        "laravel-documents"
    ],
    "homepage": "https://github.com/skyraptor/laravel-documents",
    "license": "AGPL-3.0-only",
    "authors": [
        {
            "name": "Patrick Henninger",
            "email": "privat@skyraptor.eu",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0||^13.0",
        "spatie/laravel-pdf": "^2.10"
    },
    "require-dev": {
        "dompdf/dompdf": "^3.1.6",
        "larastan/larastan": "^3.9",
        "laravel/pao": "^1.0",
        "laravel/pint": "^1.32.3",
        "mateffy/laravel-job-progress": "^2.2",
        "orchestra/testbench": "^10.0||^11.0",
        "pestphp/pest": "^4.6||^5.0",
        "pestphp/pest-plugin-laravel": "^4.1||^5.0",
        "pestphp/pest-plugin-type-coverage": "^4.0||^5.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.3.7",
        "spatie/browsershot": "^4.0||^5.0"
    },
    "autoload": {
        "psr-4": {
            "SkyRaptor\\LaravelDocuments\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SkyRaptor\\LaravelDocuments\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "prepare": [
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "build": [
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "lint": [
            "vendor/bin/pint --parallel"
        ],
        "lint:check": [
            "vendor/bin/pint --parallel --test"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse"
        ],
        "test:types": [
            "vendor/bin/pest --type-coverage --min=100"
        ],
        "test:unit": [
            "vendor/bin/pest --parallel"
        ],
        "test:mutation": [
            "Composer\\Config::disableProcessTimeout",
            "vendor/bin/pest --mutate --everything --parallel"
        ],
        "test": [
            "@analyse",
            "@lint:check",
            "@test:types",
            "@test:unit"
        ],
        "clear": [
            "@php vendor/bin/testbench package:purge-skeleton --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "SkyRaptor\\LaravelDocuments\\LaravelDocumentsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "suggest": {
        "mateffy/laravel-job-progress": "Required to use the optional built-in job progress integration.",
        "skyraptor/laravel-versioned-storage": "Required to keep multiple versions with VersionedDocumentStorage (requires a Unix-like runtime with PCNTL, POSIX, and sockets).",
        "spatie/browsershot": "Required to use the Browsershot PDF driver."
    }
}
